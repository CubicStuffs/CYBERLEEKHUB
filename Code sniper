local function fireTestAnnouncement(text)
    text = Util.trim(text)
    if text == "" then return false end
    if type(_firesignal) ~= "function" then return false end
    if not NotifyRemote or not NotifyRemote.Parent then return false end
    return pcall(_firesignal, NotifyRemote.OnClientEvent, text, 5.5, "Sounds.Sfx.Blop", "Top", 2678001507)
end
