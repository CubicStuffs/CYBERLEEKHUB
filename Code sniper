    local function fireBoxFocusLost(box)
        if not box then return false end
        local anyFired = false
        if type(_firesignal) == "function" then local ok = pcall(_firesignal, box.FocusLost, true); anyFired = anyFired or ok end
        if type(getconns) == "function" then
            local ok, cs = pcall(getconns, box.FocusLost)
            if ok and type(cs) == "table" then
                for _, c in ipairs(cs) do
                    local fn; pcall(function() fn = c.Function end)
                    if fn and type(getupvalues) == "function" and type(setupv) == "function" then
                        local uOk, ups = pcall(getupvalues, fn)
                        if uOk and type(ups) == "table" then for i, v in pairs(ups) do if type(v) == "boolean" and v == true then pcall(setupv, fn, i, false) end end end
                    end
                    local fOk = pcall(function() if c.Enabled ~= false then c:Fire(true) end end)
                    anyFired = anyFired or fOk
                end
            end
        end
        return anyFired
    end
    local function findFirstTextBoxIn(frame)
        for _, d in ipairs(frame:GetDescendants()) do if d:IsA("TextBox") and not isOurGui(d) then return d end end
        return nil
    end
    local function findSubmitButtonIn(frame)
        local firstBtn = nil
        for _, d in ipairs(frame:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                local n = d.Name:lower(); local txt = ""; pcall(function() txt = d.Text:lower() end)
                if n:find("submit") or txt:find("submit") or n:find("redeem") or txt:find("redeem") or n:find("claim") or txt:find("confirm") or n:find("enter") then return d end
                if not firstBtn and not n:find("close") and not n:find("x") then firstBtn = d end
            end
        end
        return firstBtn
    end
    local function findAnyTextBox(pg)
        local allBoxes = findAllTextBoxes(pg)
        local fallback = nil
        for _, d in ipairs(allBoxes) do
            if isVisibleChain(d) then
                local n = d.Name:lower(); local pn = (d.Parent and d.Parent.Name or ""):lower()
                if n:find("code") or pn:find("code") or n:find("redeem") or pn:find("redeem") or n:find("input") or pn:find("textbox") then return d end
                if not fallback then fallback = d end
            end
        end
        return fallback
    end
    local function findRedeemButtonNear(box)
        local searchNames = {"submit","redeem","claim","confirm","enter","send","apply","ok","use","go","check"}
        local p, depth = box.Parent, 0
        while p and depth < 8 do
            for _, d in ipairs(p:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) and d ~= box then
                    local n = d.Name:lower(); local txt = ""; pcall(function() txt = d.Text:lower() end)
                    for _, sn in ipairs(searchNames) do if n:find(sn) or txt:find(sn) then if isVisibleChain(d) then return d end end end
                end
            end
            p = p.Parent; depth = depth + 1
        end
        return nil
    end
    local function waitForTextBox(pg, timeout)
        local deadline = tick() + (timeout or 2); local found = nil
        while tick() < deadline and not found do found = findAnyTextBox(pg); if not found then task.wait() end end
        return found
    end
    function RB.typeAndSubmit(code)
        local pg = PG or LP:FindFirstChildOfClass("PlayerGui")
        if not pg then return false, "no PlayerGui" end
        local codesGui = pg:FindFirstChild("Codes")
        if codesGui then
            if codesGui:IsA("ScreenGui") then codesGui.Enabled = true end
            local codesFrame = codesGui:FindFirstChild("Codes") or codesGui
            if codesFrame then
                if codesFrame:IsA("GuiObject") then codesFrame.Visible = true end
                local cur = codesFrame
                while cur and cur ~= codesGui do if cur:IsA("GuiObject") then cur.Visible = true end; cur = cur.Parent end
                local box = findFirstTextBoxIn(codesFrame)
                local submitBtn = findSubmitButtonIn(codesFrame)
                if box then
                    pcall(function() box.Text = code end)
                    if submitBtn then
                        local times = (_spamRedeem and math.max(1, tonumber(_spamCount) or 20)) or 1
                        for i = 1, times do clickButton(submitBtn); if times > 1 then task.wait(SPAM_DELAY) end end
                    end
                    fireBoxFocusLost(box)
                    return true, "PlayerGui.Codes"
                end
            end
        end
        local btns = findCodeButtons(pg)
        for _, btn in ipairs(btns) do clickButton(btn); task.wait(0) end
        local box = waitForTextBox(pg, 2)
        if not box then return false, "no codebox" end
        pcall(function() box.Text = code end)
        local redeemBtn = findRedeemButtonNear(box)
        if redeemBtn then
            local times = (_spamRedeem and math.max(1, tonumber(_spamCount) or 20)) or 1
            for i = 1, times do clickButton(redeemBtn); if times > 1 then task.wait(SPAM_DELAY) end end
        end
        fireBoxFocusLost(box)
        return true, "dynamic"
    end
    function RB.extractBrainrot(text)
        if not text then return nil end
        local clean = tostring(text):gsub("<[^>]->",""):gsub("^%s+",""):gsub("%s+$","")
        if isSoldOutOrInvalid(clean) then return nil end
        local name = clean:match("^(.+)%s+spawned!?$")
        if name then return name:gsub("^%s+",""):gsub("%s+$","") end
        name = clean:match("^[Yy]ou%s+spawned%s+(.+)!?$") or clean:match("^[Yy]ou%s+got%s+(.+)!?$")
        if name then return name:gsub("^%s+",""):gsub("%s+$","") end
        return nil
    end
    function RB.extractIncome(text)
        if not text then return nil end
        local inc = text:match("%$([%d,]+)%s*/%s*[sS]") or text:match("%$([%d,]+)%s*per%s*[sS]")
        if inc then return inc:gsub(",","") end
        return nil
    end
end

