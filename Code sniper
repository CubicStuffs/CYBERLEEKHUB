local watchedObjects = {}
local function watchFB(obj, isInitialScan)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
    if obj:IsDescendantOf(UI.SG) then return end
    if watchedObjects[obj] then return end
    watchedObjects[obj] = true
    local function handleText()
        local text = obj.Text or ""
        if text == "" then return end
        local lower = text:lower()
        if isSoldOutOrInvalid(lower) then pendingCode = nil; return end
        if Chk.isInvalid(lower) then pendingCode = nil; return end
        if Chk.isSuccess(lower) then handleSuccess(text); return end
        if Chk.isNoiseText(text) then return end
        do
            local l = tostring(text):lower()
            local qCount = 0
            if l:find("%f[%a]which%f[%A]") then qCount = qCount + 1 end
            if l:find("%f[%a]what%f[%A]") then qCount = qCount + 1 end
            if l:find("%f[%a]who%f[%A]") then qCount = qCount + 1 end
            local isQ = qCount >= 1 or text:find("%?") ~= nil
            -- ⭐ FIX: only learn when message has personal pronouns (prevents pollution)
            local hasPersonalCue2 = l:find("%f[%a]i%f[%A]") or l:find("%f[%a]im%f[%A]") or l:find("%f[%a]my%f[%A]") or l:find("%f[%a]me%f[%A]") or l:find("%f[%a]we%f[%A]") or l:find("%f[%a]our%f[%A]") or l:find("%f[%a]sammy%f[%A]") or l:find("%f[%a]sammys%f[%A]")
            local wc2 = 0
            for _ in l:gmatch("%S+") do wc2 = wc2 + 1 end
            if hasPersonalCue2 and wc2 >= 3 and not isQ and not Riddle.isActual(text) then
                local learned = MemoryBank.feed(text)
                if learned and #learned > 0 then
                    for _, kv in ipairs(learned) do UI.typewriterLine("🧠 "..kv.k.." = "..kv.v, "mem", 0.012) end
                    refreshMemPill()
                end
            end
        end
    end
    if not isInitialScan then handleText() end
    obj:GetPropertyChangedSignal("Text"):Connect(handleText)
end
