local redeemQueue, redeemWorkerRunning = {}, false
local function doRedeem(code)
    code = Util.trim(code)
    if code == "" then return false end
    if isSoldOutOrInvalid(code) then return false end
    if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then return false end
    pendingCode = string.upper(code)
    UI.codeText.Text = pendingCode; UI.codeText.TextColor3 = C.txt
    UI.addConsoleLine(pendingCode.." submitted", "code")
    return RB.typeAndSubmit(code)
end
local function queueRedeem(code)
    code = Util.trim(code)
    if code == "" then return end
    if isSoldOutOrInvalid(code) then return end
    if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then return end
    redeemQueue[#redeemQueue + 1] = code
    if redeemWorkerRunning then return end
    redeemWorkerRunning = true
    task.spawn(function()
        while #redeemQueue > 0 and os.clock() - lastSuccessfulRedeem >= REDEEM_LOCKOUT do
            local item = table.remove(redeemQueue, 1)
            if item then doRedeem(item); task.wait(0.15) end
        end
        if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then redeemQueue = {} end
        redeemWorkerRunning = false
    end)
end
local function clearFeed()
    collectBuffer = {}
    lastRiddleText, lastRiddleAnswer = nil, nil
    pendingCode = nil
    recentWebhooks = {}
    redeemQueue = {}
    UI.clearConsole()
    UI.aText.Text = "answer…"; UI.aText.TextColor3 = C.txt
    UI.qText.Text = "waiting…"; UI.qText.TextColor3 = C.sub
    UI.codeText.Text = "type or snipe a code..."; UI.codeText.TextColor3 = C.dim
    UI.addConsoleLine("Feed cleared", "system")
end

local function handleSuccess(rawText)
    if isSoldOutOrInvalid(rawText) then return end
    local now = os.clock()
    if now - scriptLoadedAt < STARTUP_GRACE then return end
    if not pendingCode and not lastRiddleAnswer then return end
    if now - lastSuccessfulRedeem < REDEEM_LOCKOUT then return end
    local key = Util.normKey(rawText)
    if key == "" then return end
    if recentWebhooks[key] and (now - recentWebhooks[key]) < WEBHOOK_DEDUP_WINDOW then return end
    recentWebhooks[key] = now
    for k, t in pairs(recentWebhooks) do if now - t > WEBHOOK_DEDUP_WINDOW * 2 then recentWebhooks[k] = nil end end
    lastSuccessfulRedeem = now
    local isRiddle = (lastRiddleAnswer ~= nil) and pendingCode and tostring(lastRiddleAnswer):gsub("%s+",""):upper() == tostring(pendingCode):gsub("%s+",""):upper()
    local redeemedCode = pendingCode
    local riddleQ = lastRiddleText
    local redeemType = isRiddle and "Riddle" or "Code"
    local brainrotName = RB.extractBrainrot(rawText)
    local income = RB.extractIncome(rawText)
    if redeemType == "Code" and (not brainrotName or brainrotName == "" or brainrotName:lower() == "unknown") then return end
    pendingCode = nil
    lastRiddleText, lastRiddleAnswer = nil, nil
    redeemQueue = {}
    collectBuffer = {}
    if isRiddle then UI.addConsoleLine("Riddle Redeemed", "riddle")
    elseif brainrotName then UI.addConsoleLine("Code Redeemed · "..brainrotName, "success")
    else UI.addConsoleLine("Code Redeemed", "success") end
    if brainrotName then UI.addConsoleLine("   "..brainrotName..(income and (" · $"..income.."/s") or ""), "success") end
    Webhook.sendRedeem(redeemedCode, brainrotName, income, redeemType, riddleQ)
end

