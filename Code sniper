        local action = tostring(prompt.ActionText or ""):lower()
        local isPurchase = action:find("%f[%a]purchase%f[%A]") ~= nil
        local pp = prompt.Parent
        local pos
        if pp and pp:IsA("Attachment") then pos = pp.WorldPosition
        elseif pp and pp:IsA("BasePart") then pos = pp.Position
        else local wp = pp and pp:FindFirstAncestorWhichIsA("BasePart"); pos = wp and wp.Position end
        if prompt.Parent and prompt.Enabled and isPurchase and pos and (root.Position-pos).Magnitude <= autoBuyRadius then
            prompt.HoldDuration = 0
            pcall(function()
                if type(_fireproximityprompt) == "function" then _fireproximityprompt(prompt)
                else prompt:InputHoldBegin(); prompt:InputHoldEnd() end
            end)
        end
    end
end)

