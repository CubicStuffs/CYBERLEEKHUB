        TweenService:Create(line, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
        task.defer(function() if console and console.Parent then console.CanvasPosition = Vector2.new(0, math.max(0, console.AbsoluteCanvasSize.Y - console.AbsoluteSize.Y)) end end)
        return line
    end
    local function typewriterLine(text, colorKey, speed)
        speed = speed or 0.04
        consoleOrder += 1
        local color = consoleColors[colorKey] or C.txt
        local time = os.date("%H:%M:%S")
        local prefix = string.format("[%s] ", time)
        local line = new("TextLabel", { Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Text=prefix, Font=FBK, TextSize=9, TextColor3=color, TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, LayoutOrder=consoleOrder, ZIndex=4 }, console)
        task.spawn(function()
            for i = 1, #text do if not line.Parent then return end; line.Text = prefix .. text:sub(1, i); task.wait(speed) end
        end)
        return line
    end
    local function shineLine(text, colorKey, speed)
        speed = speed or 0.08
        consoleOrder += 1
        local color = consoleColors[colorKey] or C.txt
        local time = os.date("%H:%M:%S")
        local prefix = string.format("[%s] ", time)
        local line = new("TextLabel", { Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Text=prefix, Font=FBK, TextSize=10, TextColor3=Color3.fromRGB(255,255,255), TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, LayoutOrder=consoleOrder, ZIndex=4 }, console)
        task.spawn(function()
            for i = 1, #text do if not line.Parent then return end; line.Text = prefix .. text:sub(1, i); task.wait(speed) end
            task.wait(0.2)
            if not line.Parent then return end
            local grad = new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, color), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)), ColorSequenceKeypoint.new(1, color) }), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 0.55) }), Rotation = 45 }, line)
            task.spawn(function()
                while line.Parent do
                    grad.Offset = Vector2.new(-1, 0)
                    TweenService:Create(grad, TweenInfo.new(1.1, Enum.EasingStyle.Linear), { Offset = Vector2.new(1, 0) }):Play()
                    task.wait(1.5)
                end
            end)
        end)
        return line
    end
