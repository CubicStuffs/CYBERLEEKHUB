-- ⭐ Decode HTML entities (fixes "&apos;" breaking riddles like TODAY'S DAY)
local function decodeHtmlEntities(text)
    if not text then return text end
    text = text:gsub("&apos;", "'"):gsub("&#39;", "'")
    text = text:gsub("&quot;", '"'):gsub("&#34;", '"')
    text = text:gsub("&amp;", "&"):gsub("&#38;", "&")
    text = text:gsub("&lt;", "<"):gsub("&gt;", ">")
    text = text:gsub("&nbsp;", " ")
    text = text:gsub("&#(%d+);", function(n)
        local c = tonumber(n); return c and string.char(c) or ""
    end)
    text = text:gsub("&[%w#]+;", "")
    return text
end

local function handleRiddle(rawText)
    if isSoldOutOrInvalid(rawText) then return end
    rawText = decodeHtmlEntities(rawText)
    UI.qText.Text = rawText
    UI.qText.TextColor3 = C.txt
    if not riddleSolverEnabled then
        UI.aText.Text = "Riddler is OFF"; UI.aText.TextColor3 = C.dim; return
    end
    if not Riddle.isRiddleLike(rawText) then return end
    UI.addConsoleLine("Riddle: "..rawText, "riddle")
    UI.aText.Text = "solving…"; UI.aText.TextColor3 = C.yellow

    -- ⭐ Full multi-part solve FIRST (handles "X and Y and Z" natively)
    local fullSolve = Riddle.solve(rawText)
    local memAns = MemoryBank.answer(rawText)
    local kbAns, _, kbPat, kbScore = nil, nil, nil, nil
    if Riddle.findFirstMatch then
        kbAns, _, kbPat, kbScore = Riddle.findFirstMatch(rawText)
    end
    local kbWords = 0
    if kbPat then for _ in kbPat:gmatch("%S+") do kbWords = kbWords + 1 end end

    local answer, source
    if fullSolve and #fullSolve > 0 then
        answer, source = fullSolve, "knowledge"
    elseif memAns and #memAns > 0 then
        answer, source = memAns, "memory"
    elseif kbAns and kbScore and kbScore >= 100 and kbWords >= 2 then
        answer, source = kbAns, "knowledge"
    elseif kbAns and #kbAns > 0 then
        answer, source = kbAns, "knowledge"
    end

    -- ⭐ Fallback: if full solve failed, try the BASE (before last "and")
    if not answer then
        local baseOnly = rawText:match("^(.-)%s+and%s+")
        if baseOnly then
            local b = Riddle.solve(baseOnly)
                or (Riddle.findFirstMatch and Riddle.findFirstMatch(baseOnly))
                or MemoryBank.answer(baseOnly)
            if b and #b > 0 then answer = b; source = "knowledge" end
        end
    end

    -- ⭐ Suffix append: only when tail is a SINGLE word/number
    --   "rarest brainrot and 67"     → POLAROIDINI + 67     = POLAROIDINI67
    --   "rarest brainrot and summer" → POLAROIDINI + SUMMER = POLAROIDINISUMMER
    if answer then
        local baseText, suffixText = rawText:match("^(.-)%s+and%s+(.+)$")
        if baseText and suffixText then
            local s = suffixText:gsub("^%s+",""):gsub("%s+$","")
            local wc = 0
            for _ in s:gmatch("%S+") do wc = wc + 1 end
            if wc == 1 then
                local numOnly = s:match("^(%d+)$")
                local append
                if numOnly then append = numOnly
                else
                    local sAns = (Riddle.findFirstMatch and Riddle.findFirstMatch(s)) or Riddle.findByName(s)
                    if sAns and #sAns > 0 then append = sAns
                    else append = s:gsub("[^%w]",""):upper() end
                end
                if append and #append > 0 and not answer:find(append, 1, true) then
                    answer = answer .. append
                end
            end
        end
    end

    if answer and #answer > 0 then
        lastRiddleText = rawText
        lastRiddleAnswer = answer
        UI.aText.Text = answer; UI.aText.TextColor3 = C.green
        task.spawn(flashAnswerBox, C.green)
        AnimH.popIn(UI.aBox)
        UI.aText.TextSize = 12
        TweenService:Create(UI.aText, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextSize = 10}):Play()
        UI.addConsoleLine("📚 "..answer.." ("..source..")", "success")
        queueRedeem(answer)
    else
        UI.aText.Text = "No answer found"; UI.aText.TextColor3 = C.red
        task.spawn(flashAnswerBox, C.red)
        UI.addConsoleLine("⚠ No answer", "warn")
    end
end

local POSITIONS = {Top=true, Bottom=true, Center=true, Middle=true, Left=true, Right=true, TopRight=true, TopLeft=true, BottomRight=true, BottomLeft=true}
local function extractAnnouncementText(...)
    local packed = table.pack(...)
    local best
    for i = 1, packed.n do
        local v = packed[i]
        if typeof(v) == "string" then
            local text = Util.stripRich(v)
            local lower = text:lower()
            if text ~= "" and not lower:find("sounds%.") and not lower:find("rbxassetid") and not POSITIONS[text] then
                if not best or #text > #best then best = text end
            end
        end
    end
    return Util.stripRich(tostring(best or ((...) or "")))
end

local riddleCooldown = {}
local function onAnnouncement(...)
    local rawText = extractAnnouncementText(...)
    if rawText == "" then return end
    if isSoldOutOrInvalid(rawText) then return end
    if not Chk.isNoiseText(rawText) then
        local l = tostring(rawText):lower()
        local qCount = 0
        if l:find("%f[%a]which%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]where%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]what%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]who%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]when%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]why%f[%A]") then qCount = qCount + 1 end
        if l:find("%f[%a]how%f[%A]") then qCount = qCount + 1 end
        local isQuestion = qCount >= 1 or rawText:find("%?") ~= nil
        local isCodeCue = Chk.isCodeCue(rawText)
        -- ⭐ FIX: only learn from messages that contain personal pronouns
        -- (prevents riddle answers like "ARGENTINA" from polluting memory)
        local hasPersonalCue = l:find("%f[%a]i%f[%A]") or l:find("%f[%a]im%f[%A]") or l:find("%f[%a]my%f[%A]") or l:find("%f[%a]me%f[%A]") or l:find("%f[%a]we%f[%A]") or l:find("%f[%a]our%f[%A]") or l:find("%f[%a]sammy%f[%A]") or l:find("%f[%a]sammys%f[%A]")
        local wordCountForFeed = 0
        for _ in l:gmatch("%S+") do wordCountForFeed = wordCountForFeed + 1 end
        if hasPersonalCue and wordCountForFeed >= 3 and not isQuestion and not isCodeCue and not Riddle.isActual(rawText) and not l:find("spawned!") and not l:find("has spawned") and not l:find("code redeemed") and not l:find("you got") and not l:find("you received") and not l:find("congratulations") then
            local learned = MemoryBank.feed(rawText)
            if learned and #learned > 0 then
                for _, kv in ipairs(learned) do UI.typewriterLine("🧠 "..kv.k.." = "..kv.v, "mem", 0.012) end
                refreshMemPill()
            end
        end
    end
    if Chk.isBlacklisted(rawText) then return end
    if os.clock() - lastSuccessfulRedeem < REDEEM_LOCKOUT then return end
    local lower = rawText:lower()
    if lower:find("code is", 1, true) or lower:find("use code", 1, true) or lower:find("riddle is", 1, true) or lower:find("question is", 1, true) or Riddle.isActual(rawText) then
        autoEnableOnCodeCue()
    end
    local hadCodeCue = Chk.isActualCodeCue(rawText)
    local stripped = Util.stripCuePrefix(rawText)
    if stripped ~= "" and stripped ~= rawText then
        UI.addConsoleLine("Stripped: '"..stripped.."'", "system")
        rawText = stripped
        lower = rawText:lower()
    end
    -- ⭐ FIX: if original had "use code"/"code is" prefix, the text after the cue
    -- IS the code verbatim — just strip spaces/punctuation and uppercase it.
    -- Never run Riddle.solve here (it would substring-match "jandel" from
    -- "jandel sucks 666" and drop the middle words).
    if hadCodeCue then
        -- ⭐ FIX: rawText is ALREADY stripped above; skip if it's just a bare cue
        local bareCue = rawText:lower():gsub("[%s%p]+", "")
        if bareCue == "" or bareCue == "usecode" or bareCue == "thecodeis"
           or bareCue == "codeis" or bareCue == "riddleis"
           or bareCue == "questionis" or bareCue == "usethiscode" then
            UI.addConsoleLine("Ignored empty code cue", "system")
            return
        end
        -- ⭐ try riddle KB first (exact multi-word match); else submit literal
        --  - "code is the rarest brainrot"  → POLAROIDINI   (riddle match)
        --  - "use code phoenix24"            → PHOENIX24     (literal)
        --  - "use code tung tung tung"       → TUNGTUNGTUNG  (literal)
        --  - "use code jandel sucks 666"     → JANDELSUCKS666 (literal)
        local kbAns, kbPat, kbScore = nil, nil, nil
        if Riddle.findFirstMatch then
            kbAns, _, kbPat, kbScore = Riddle.findFirstMatch(rawText)
        end
        local kbWords = 0
        if kbPat then for _ in kbPat:gmatch("%S+") do kbWords = kbWords + 1 end end
        if kbAns and kbScore and kbScore >= 100 and kbWords >= 2 then
            UI.aText.Text = kbAns; UI.aText.TextColor3 = C.green
            UI.codeText.Text = kbAns; UI.codeText.TextColor3 = C.green
            UI.addConsoleLine("Code (riddle): "..kbAns, "code")
            queueRedeem(kbAns)
        else
            local cleaned = rawText:gsub("[^%w]",""):upper()
            if #cleaned >= 2 then
                UI.aText.Text = cleaned; UI.aText.TextColor3 = C.txt
                UI.codeText.Text = cleaned; UI.codeText.TextColor3 = C.txt
                UI.addConsoleLine("Code: "..cleaned, "code")
                queueRedeem(cleaned)
            else
                UI.addConsoleLine("Ignored too-short code", "system")
            end
        end
        return
    end
    -- After stripping, if it's multi-word, treat as riddle
    if listening and riddleSolverEnabled and rawText:find("%s") then
        local key = rawText:lower():gsub("%s+", " ")
        local now = os.clock()
        if not riddleCooldown[key] or (now - riddleCooldown[key]) > 3 then
            riddleCooldown[key] = now
            handleRiddle(rawText)
            return
        end
    end
    if listening then
        local wordCount = 0
        for _ in rawText:gmatch("%S+") do wordCount = wordCount + 1 end
        if wordCount > 1 then return end
        local words = Util.tokenize(rawText)
        if #words == 0 then return end
        for _, w in ipairs(words) do
            collectBuffer[#collectBuffer + 1] = w
            local joined = table.concat(collectBuffer)
            UI.aText.Text = string.upper(joined); UI.aText.TextColor3 = C.txt
            UI.codeText.Text = string.upper(joined); UI.codeText.TextColor3 = C.txt
            queueRedeem(joined)
        end
    end
end

