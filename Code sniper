        if l == "" then return end
        tryExtractLocation(l, learned); tryExtractDevice(l, learned); tryExtractSpecialDays(l, learned); tryExtractRelations(l, learned)
        local luckN = l:match("(%d+)%s*x%s*luck") or l:match("(%d+)%s*luck")
        if luckN then if addFact("LUCK", luckN.."X", "luck") then pushLearned(learned, "LUCK", luckN.."X") end end
        do
            local nm = l:match("my%s+name%s+is%s+(%a+)") or l:match("name%s+is%s+(%a+)") or l:match("im%s+called%s+(%a+)") or l:match("call%s+me%s+(%a+)")
            if nm and not isStop(nm) and not isAdjective(nm) then if addFact("NAME", nm, "name") then pushLearned(learned, "NAME", up(nm)) end end
        end
        do
            local age = l:match("i%s+am%s+(%d+)%s+years") or l:match("im%s+(%d+)%s+years") or l:match("my%s+age%s+is%s+(%d+)")
            if age then if addFact("AGE", age, "age") then pushLearned(learned, "AGE", age) end end
        end
        for sub, obj in l:gmatch("my%s+favorite%s+(%a+)%s+is%s+([%a%d]+)") do
            if not isStop(sub) and not isStop(obj) and not isAdjective(obj) then if addFact("FAVORITE_"..sub, obj, "favorite") then pushLearned(learned, "FAVORITE_"..up(sub), up(obj)) end end
        end
        for sub, obj in l:gmatch("my%s+(%a+)%s+is%s+([%a%d]+)") do
            if not isStop(sub) and not isStop(obj) then
                if DEVICE_WORDS[sub:lower()] then
                elseif not isAdjective(obj) then
                    if addFact(sub, obj, "possessive") then pushLearned(learned, up(sub), up(obj)) end
                end
            end
        end
        for sub, obj in l:gmatch("(%a+)%s+is%s+([%a%d]+)") do
            if not isStop(sub) and not isStop(obj) and #sub > 2 and #obj > 2 and not isAdjective(obj) then
                if addFact(sub, obj, "is-statement") then pushLearned(learned, up(sub), up(obj)) end
            end
        end
        for obj in l:gmatch("i have a%s+(%a+)") do if not isStop(obj) and not isAdjective(obj) then if addFact("HAS_"..obj, "YES", "possession") then pushLearned(learned, "HAS_"..up(obj), "YES") end end end
        for obj in l:gmatch("i like%s+(%a+)") do if not isStop(obj) and not isAdjective(obj) then if addFact("LIKES_"..obj, "YES", "preference") then pushLearned(learned, "LIKES_"..up(obj), "YES") end end end
        local action = l:match("im%s+doing%s+(%a+)") or l:match("im%s+playing%s+(%a+)")
        if action and not isStop(action) and not isAdjective(action) then if addFact("ACTION", action, "action") then pushLearned(learned, "ACTION", up(action)) end end
    end
    local function extract(sentence)
        local l = clean(sentence)
        if l == "" then return {} end
        if isNoise(l) then return {} end
        local learned = {}
        local chunks = splitOnSo(l)
        for _, chunk in ipairs(chunks) do
            local main, reason = splitBecause(chunk)
            extractFromClause(main, learned)
            if reason then extractFromClause(reason, learned) end
        end
        return learned
    end
    function MemoryBank.feed(text)
        if not text or text == "" then return {} end
        rawLog[#rawLog+1] = {text = text, t = os.clock()}
        if #rawLog > 60 then table.remove(rawLog, 1) end
        return extract(text)
    end
    local function splitMulti(q)
        local parts = {}
        q = q:gsub("&", " and "):gsub("%+", " and "):gsub(",", " and "):gsub(";", " and ")
        q = q:gsub("%s+also%s+", " and "):gsub("%s+plus%s+", " and ")
        local current = {}
        local function flush()
            if #current > 0 then
                local s = table.concat(current, " ")
                local subparts, buf = {}, {}
                for word in s:gmatch("%S+") do
                    if word == "my" and #buf > 1 then subparts[#subparts+1] = table.concat(buf, " "); buf = { word }
                    else buf[#buf+1] = word end
                end
                if #buf > 0 then subparts[#subparts+1] = table.concat(buf, " ") end
                for _, sp in ipairs(subparts) do
                    sp = sp:match("^%s*(.-)%s*$") or ""
                    if sp ~= "" then parts[#parts+1] = sp end
                end
                current = {}
            end
        end
        for word in q:gmatch("%S+") do if word == "and" then flush() else current[#current+1] = word end end
        flush()
        return parts
    end
    local function detectIntent(q)
        local intents = {}
        if q:find("special") or q:find("birthday") or q:find("celebrat") or q:find("holiday") then intents[#intents+1] = "SPECIAL" end
        if q:find("where") or q:find("location") or q:find("live") or q:find("right now") or q:find("am i") then intents[#intents+1] = "LOCATION" end
        if q:find("luck") or q:find("multiplier") or q:find("boost") then intents[#intents+1] = "LUCK" end
        if q:find("why") or q:find("reason") then intents[#intents+1] = "REASON" end
        if q:find("event") or q:find("admin abuse") then intents[#intents+1] = "EVENT" end
        if q:find("how many") or q:find("amount") or q:find("count") then intents[#intents+1] = "COUNT" end
        if q:find("what am i doing") or q:find("action") then intents[#intents+1] = "ACTION" end
        if q:find("device") or q:find("using") or q:find("laptop") or q:find("phone") or q:find("computer") or q:find("tablet") or q:find("playing on") then intents[#intents+1] = "DEVICE" end
        if q:find("skin") or q:find("tone") then intents[#intents+1] = "SKIN" end
        if (q:find("cat") and q:find("name")) or q:find("kitty") then intents[#intents+1] = "CAT_NAME" end
        if (q:find("pet") and q:find("name")) then intents[#intents+1] = "PET_NAME" end
        if (q:find("name") or q:find("called")) and not q:find("last name") and not q:find("surname") and not q:find("real life") and not q:find("skin") and not q:find("cat") and not q:find("dog") and not q:find("pet") and not q:find("kitty") then intents[#intents+1] = "NAME" end
        if q:find("age") or q:find("old") then intents[#intents+1] = "AGE" end
        return intents
    end
    local function answerSingle(q)
        if q == "" then return nil end
        local qK = kws(q)
        local intents = detectIntent(q)
        for _, intent in ipairs(intents) do
            if intent == "SPECIAL" then
                local parts = {}
                for _, f in ipairs(facts) do if f.attr:match("^SPECIALDAY_") then parts[#parts+1] = f.value end end
                if #parts > 0 then return table.concat(parts) end
            end
            for _, f in ipairs(facts) do
                if intent == "LOCATION" and f.attr == "LOCATION" then return f.value end
                if intent == "LUCK" and f.attr == "LUCK" then return f.value end
                if intent == "REASON" and f.attr == "REASON" then return f.value end
                if intent == "EVENT" and (f.attr == "EVENT" or f.attr == "ACTION") then return f.value end
                if intent == "ACTION" and f.attr == "ACTION" then return f.value end
                if intent == "DEVICE" and f.attr == "DEVICE" then return f.value end
                if intent == "SKIN" and f.attr == "SKIN" then return f.value end
                if intent == "CAT_NAME" and f.attr == "CAT_NAME" then return f.value end
                if intent == "PET_NAME" and f.attr == "PET_NAME" then return f.value end
                if intent == "NAME" and f.attr == "NAME" then return f.value end
                if intent == "AGE" and f.attr == "AGE" then return f.value end
                if intent == "COUNT" and f.attr:match("^COUNT_") then return f.value end
            end
        end
        local best, bestScore = nil, 0
        for _, f in ipairs(facts) do
            local score = 0
            for _, qk in ipairs(qK) do for _, fk in ipairs(f.kws) do if qk == fk then score = score + 3 end end end
            if q:find(f.attr:lower(), 1, true) then score = score + 8 end
            if score > bestScore then bestScore = score; best = f.value end
        end
        if best and bestScore >= 4 then return best end
        return nil
    end
    function MemoryBank.answer(question)
        if not question or question == "" then return nil end
        local q = clean(question)
        local parts = splitMulti(q)
        if #parts > 1 then
            local answers = {}
            local allWorked = true
            for _, piece in ipairs(parts) do
                local numOnly = piece:match("^%s*(%d+)%s*$")
                if numOnly then answers[#answers+1] = numOnly
                else
                    local ans = answerSingle(piece)
                    if not ans then ans = Riddle.solve(piece) end
                    if ans and #ans > 0 then answers[#answers+1] = ans
                    else allWorked = false; break end
                end
            end
            if allWorked and #answers > 0 then return table.concat(answers) end
        end
        return answerSingle(q)
    end
    function MemoryBank.summary()
        local parts = {}
        for _, f in ipairs(facts) do parts[#parts+1] = f.attr.."="..f.value end
        if #parts == 0 then return "Memorizing..." end
        if #parts > 3 then return table.concat({parts[#parts-2],parts[#parts-1],parts[#parts]}, " · ") end
        return table.concat(parts, " · ")
    end
    function MemoryBank.reset() facts = {}; rawLog = {} end
end

