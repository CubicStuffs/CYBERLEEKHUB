        end)
    end
    function AnimH.pulse(obj, prop, low, high, dur)
        dur = dur or 0.9
        task.spawn(function()
            while obj and obj.Parent do
                TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {[prop] = high}):Play()
                task.wait(dur)
                if not obj or not obj.Parent then return end
                TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {[prop] = low}):Play()
                task.wait(dur)
            end
        end)
    end
    function AnimH.bounce(obj, amt)
        amt = amt or 1.15
        local s = obj:FindFirstChildOfClass("UIScale") or new("UIScale", {Scale = 1}, obj)
        local base = s.Scale
        s.Scale = base * amt
        TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = base}):Play()
    end
    function AnimH.float(obj, amount, dur)
        amount = amount or 2
        dur = dur or 1.8
        local basePos = obj.Position
        task.spawn(function()
            while obj and obj.Parent do
                TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Position = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, basePos.Y.Offset - amount)}):Play()
                task.wait(dur)
                if not obj or not obj.Parent then return end
                TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Position = basePos}):Play()
                task.wait(dur)
            end
        end)
    end
    function AnimH.softStagger(container, fromY)
        fromY = fromY or 12
        local idx = 0
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextButton") then
                idx = idx + 1
                local basePos = child.Position
                local baseTrans = child.BackgroundTransparency
                local baseY = basePos.Y.Offset
                child.Position = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, baseY + fromY)
                child.BackgroundTransparency = 1
                local delay = 0.025 * idx
                task.delay(delay, function()
                    if not child.Parent then return end
                    TweenService:Create(child, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, baseY),
                        BackgroundTransparency = baseTrans,
                    }):Play()
                end)
            end
        end
    end
    function AnimH.popIn(obj)
